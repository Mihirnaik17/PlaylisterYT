# Server
PORT=4000
JWT_SECRET=replace-me

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Database (configure based on your db layer in /server/db)
# If you use MongoDB:
MONGO_URI=mongodb://localhost:27017/playlister

# If you use Postgres/Sequelize:
POSTGRES_URI=postgres://user:password@localhost:5432/playlister

# Client (CRA build-time)
# REACT_APP_API_URL=http://localhost:4000

